{
  "name": "genui-input",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/genui/input/src",
  "projectType": "library",
  "tags": ["scope:app"],
  "// targets": "to see all targets run: nx show project genui-input --web",
  "targets": {
    "format": {
      "command": "prettier --write {projectRoot}"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/test-output/vitest/coverage"
      }
    }
  }
}
