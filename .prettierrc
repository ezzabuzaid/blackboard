{
  "singleQuote": true,
  "importOrder": [
    "./env",
    "./exceptions",
    "./startup",
    "^node:(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@stdlib/(.*)$",
    "^@workspace/(.*)$",
    "^[./]"
  ],
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "overrides": [
    {
      "files": ["*.css", "*.scss", "*.less"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
