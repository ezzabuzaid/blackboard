{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "ai": ["./node_modules/ai/dist/index.d.ts"],
      "@ai-sdk/provider": ["./node_modules/@ai-sdk/provider/dist/index.d.ts"],
      "@ai-sdk/provider-utils": [
        "./node_modules/@ai-sdk/provider-utils/dist/index.d.ts"
      ],
      "hono": ["./node_modules/hono/dist/types/index.d.ts"]
    }
  }
}
